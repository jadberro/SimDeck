<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- SimDeck itself references no packages. nuget.org is still required
         because a self-contained publish downloads the .NET runtime packs
         (Microsoft.NETCore.App.Runtime.win-x64 and the WindowsDesktop pair)
         from here. Clearing this breaks `dotnet publish -r win-x64`. -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
