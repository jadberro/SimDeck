<UserControl x:Class="SimDeck.App.Views.FirmwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="Firmware" Style="{StaticResource H1}"/>
      <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0"
                 Text="Grouped by module type. One image serves every panel of that type."/>
    </StackPanel>

    <ItemsControl Grid.Row="1" ItemsSource="{Binding Firmware}">
      <ItemsControl.Template>
        <ControlTemplate TargetType="ItemsControl">
          <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
        </ControlTemplate>
      </ItemsControl.Template>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding ModuleType}" FontSize="13"
                             FontFamily="Consolas"/>
                  <TextBlock Text="{Binding VersionLine}" Margin="10,0,0,0"
                             FontSize="12" VerticalAlignment="Center">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Dim}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Behind}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Warn}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
                <TextBlock Text="{Binding DeviceLine}" Style="{StaticResource Muted}"
                           Margin="0,5,0,0"/>
              </StackPanel>

              <Button Grid.Column="1" Content="Update all" VerticalAlignment="Center"
                      IsEnabled="{Binding Behind}"
                      Command="{Binding DataContext.UpdateAllOfType,
                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                      CommandParameter="{Binding}"/>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
      <Button Content="Add image…" Command="{Binding AddImage}"/>
      <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"
                 Text="Name files &lt;module_type&gt;_&lt;version&gt;.bin"/>
    </StackPanel>
  </Grid>
</UserControl>
