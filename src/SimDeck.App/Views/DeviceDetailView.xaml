<UserControl x:Class="SimDeck.App.Views.DeviceDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="18" DataContext="{Binding}">

      <Button HorizontalAlignment="Left" BorderThickness="0" Padding="0,0,0,10"
              Command="{Binding Back}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                     Foreground="{StaticResource Dim}" Margin="0,0,6,0"/>
          <TextBlock Text="Devices" Foreground="{StaticResource Dim}" FontSize="12"/>
        </StackPanel>
      </Button>

      <TextBlock Text="{Binding Selected.Name}" Style="{StaticResource H1}"/>
      <TextBlock Text="{Binding Selected.Subtitle}" Style="{StaticResource Muted}"
                 Margin="0,2,0,14"/>

      <Border Style="{StaticResource CardBorder}">
        <ItemsControl ItemsSource="{Binding Selected.Values}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}"
                           Foreground="{StaticResource Dim}" FontSize="12"/>
                <TextBlock Grid.Column="1" Text="{Binding Display}"
                           Foreground="{StaticResource Accent}" FontSize="12"
                           FontFamily="Consolas"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <Border Style="{StaticResource CardBorder}" Margin="0,10,0,0"
              Visibility="{Binding Selected.OtaVisible,
                           Converter={StaticResource BoolToVis}}">
        <StackPanel>
          <TextBlock Text="{Binding Selected.OtaLine}" Style="{StaticResource Muted}"/>
          <ProgressBar Height="6" Margin="0,8,0,0" Minimum="0" Maximum="100"
                       Value="{Binding Selected.OtaPercent}"
                       Background="#1E252C" Foreground="{StaticResource Accent}"
                       BorderThickness="0"/>
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
        <Button Content="Identify" Margin="0,0,6,0" Command="{Binding Identify}"/>
        <Button Content="Push firmware" Command="{Binding PushFirmware}"/>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
