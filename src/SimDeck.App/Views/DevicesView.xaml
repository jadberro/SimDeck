<UserControl x:Class="SimDeck.App.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="Devices" Style="{StaticResource H1}"/>
      <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0"
                 Text="Modules announce themselves. Nothing to configure here."/>
    </StackPanel>

    <Grid Grid.Row="1">
      <TextBlock HorizontalAlignment="Center"
                 VerticalAlignment="Center" TextAlignment="Center" MaxWidth="320"
                 Text="No devices yet. Power a panel on and it will appear here within a few seconds.">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding Devices.Count}" Value="0">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>

      <ItemsControl ItemsSource="{Binding Devices}">
        <ItemsControl.Template>
          <ControlTemplate TargetType="ItemsControl">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsPresenter/>
            </ScrollViewer>
          </ControlTemplate>
        </ItemsControl.Template>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Margin="0,0,0,8" HorizontalContentAlignment="Stretch"
                    BorderBrush="{StaticResource Line}" Background="{StaticResource Card}"
                    Padding="14,12"
                    Command="{Binding DataContext.OpenDevice,
                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,0,11,0"
                         VerticalAlignment="Center" Fill="{Binding StatusColour}"/>

                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding Name}" FontSize="13"/>
                  <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}"
                             Margin="0,2,0,0"/>
                </StackPanel>

                <Border Grid.Column="2" CornerRadius="9" Padding="8,2" Margin="8,0"
                        Background="#3A2E14" VerticalAlignment="Center"
                        Visibility="{Binding UpdateAvailable,
                                     Converter={StaticResource NullToVis}}">
                  <TextBlock Text="Update ready" FontSize="11"
                             Foreground="{StaticResource Warn}"/>
                </Border>

                <TextBlock Grid.Column="3" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                           FontSize="12" Foreground="{StaticResource Dim}"
                           VerticalAlignment="Center"/>
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
  </Grid>
</UserControl>
