<UserControl x:Class="SimDeck.App.Views.PanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:SimDeck.App.Views">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="Accumulator / brake panel" Style="{StaticResource H1}"/>
      <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0"
                 Text="{Binding PanelSubtitle}"/>
    </StackPanel>

    <Border Grid.Row="1" Background="#0A0A0A" CornerRadius="10"
            BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14">
      <v:GaugeControl x:Name="Gauge" HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
    </Border>

    <Grid Grid.Row="2" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock Text="Accumulator" Style="{StaticResource Muted}"/>
        <TextBlock Text="{Binding AccumText}" FontSize="20" FontFamily="Consolas"
                   Foreground="{StaticResource Accent}"/>
      </StackPanel>
      <StackPanel Grid.Column="1">
        <TextBlock Text="Brake left" Style="{StaticResource Muted}"/>
        <TextBlock Text="{Binding LeftText}" FontSize="20" FontFamily="Consolas"
                   Foreground="{StaticResource Accent}"/>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="Brake right" Style="{StaticResource Muted}"/>
        <TextBlock Text="{Binding RightText}" FontSize="20" FontFamily="Consolas"
                   Foreground="{StaticResource Accent}"/>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
