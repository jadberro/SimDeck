<UserControl x:Class="SimDeck.App.Views.VariablesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="Variables" Style="{StaticResource H1}"/>
      <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap"
                 Text="Scan the aircraft, filter by name, then tick a few and watch which ones move when you set the parking brake."/>
    </StackPanel>

    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="{Binding BridgeLine}" FontFamily="Consolas" FontSize="12"/>
        <TextBlock Text="{Binding BridgeHint}" Style="{StaticResource Muted}"
                   Margin="0,6,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <Grid Grid.Row="2" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBox Grid.Column="0" Text="{Binding Vars.Filter, UpdateSourceTrigger=PropertyChanged}"
               Background="#161B20" Foreground="{StaticResource Fg}"
               BorderBrush="{StaticResource Line}" Padding="8,6" FontSize="12"/>
      <Button Grid.Column="1" Content="Scan sim" Margin="6,0,0,0"
              Command="{Binding Vars.Scan}"/>
      <Button Grid.Column="2" Content="Clear ticks" Margin="6,0,0,0"
              Command="{Binding Vars.ClearProbes}"/>
    </Grid>

    <Grid Grid.Row="3" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Content="Read from aircraft files"
              Command="{Binding Vars.ImportFromAircraft}"/>
      <Button Grid.Column="1" Content="Browse…" Margin="6,0,0,0"
              Command="{Binding Vars.BrowseForFile}"/>
      <TextBox Grid.Column="2" Margin="12,0,0,0"
               Text="{Binding Vars.ManualName, UpdateSourceTrigger=PropertyChanged}"
               Background="#161B20" Foreground="{StaticResource Fg}"
               BorderBrush="{StaticResource Line}" Padding="8,6" FontSize="12"
               ToolTip="Type a variable name to watch it directly"/>
      <Button Grid.Column="3" Content="Watch" Margin="6,0,0,0"
              Command="{Binding Vars.AddManual}"/>
    </Grid>

    <Border Grid.Row="4" Style="{StaticResource CardBorder}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{Binding Vars.Status}" Style="{StaticResource Muted}"
                   TextWrapping="Wrap" Margin="0,0,0,8"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Vars.Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <CheckBox Grid.Column="0" IsChecked="{Binding Probed}"
                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <TextBlock Grid.Column="1" Text="{Binding Name}" FontFamily="Consolas"
                             FontSize="12" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="2" Text="{Binding Value}" FontFamily="Consolas"
                             FontSize="12" Foreground="{StaticResource Accent}"
                             MinWidth="90" TextAlignment="Right"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
