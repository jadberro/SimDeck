<Application x:Class="SimDeck.Bench.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BgDark" Color="#121417"/>
        <SolidColorBrush x:Key="CardBg" Color="#1E2228"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2E3440"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#ECEFF4"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#8892B0"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#2ECC71"/>
        <SolidColorBrush x:Key="AccentAmber" Color="#F39C12"/>
        <SolidColorBrush x:Key="AccentRed" Color="#E74C3C"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#3498DB"/>
    </Application.Resources>
</Application>
