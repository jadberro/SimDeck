<Window x:Class="SimDeck.Bench.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SimDeck.Bench.Views"
        Title="SimDeck Bench — Virtual Instrument Panel"
        Height="620" Width="1040"
        MinHeight="560" MinWidth="850"
        Background="#0E1013"
        Foreground="#ECEFF4">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#252A33"/>
            <Setter Property="Foreground" Value="#ECEFF4"/>
            <Setter Property="BorderBrush" Value="#353D4B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2F3642"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#4C566A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1F232B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="500"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Calibrated Instrument Face -->
        <Border Grid.Column="0" Background="#16181D" BorderBrush="#222730" BorderThickness="1"
                CornerRadius="8" Padding="10">
            <Grid>
                <!-- Outer bezel preview -->
                <Ellipse Width="480" Height="480" Stroke="#2D333F" StrokeThickness="2" Fill="#000000"/>
                <views:GaugeControl x:Name="Gauge" Width="480" Height="480"/>
            </Grid>
        </Border>

        <!-- Right: Telemetry & Interactive Bench Controls -->
        <Grid Grid.Column="1" Margin="16,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header & Identity -->
            <Border Grid.Row="0" Background="#16181D" BorderBrush="#222730" BorderThickness="1"
                    CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="A320 Triple Indicator Bench" FontSize="16" FontWeight="SemiBold" Foreground="#ECEFF4"/>
                        <TextBlock Text="Module: accu-bench · Type: accu_panel" FontSize="11" Foreground="#7B88A1" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#E74C3C" Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatusText" Text="Connecting..." FontSize="12" FontWeight="Medium" Foreground="#ECEFF4"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Wire Telemetry Grid -->
            <Border Grid.Row="1" Background="#16181D" BorderBrush="#222730" BorderThickness="1"
                    CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="LIVE WIRE TELEMETRY (PORT 27501)" FontSize="11" FontWeight="Bold" Foreground="#65738E" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ACCUMULATOR" FontSize="10" Foreground="#8892B0"/>
                            <TextBlock x:Name="TxtAccum" Text="0 psi" FontSize="15" FontWeight="Bold" Foreground="#ECEFF4" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="LEFT BRAKE" FontSize="10" Foreground="#8892B0"/>
                            <TextBlock x:Name="TxtLeft" Text="0 psi" FontSize="15" FontWeight="Bold" Foreground="#ECEFF4" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="RIGHT BRAKE" FontSize="10" Foreground="#8892B0"/>
                            <TextBlock x:Name="TxtRight" Text="0 psi" FontSize="15" FontWeight="Bold" Foreground="#ECEFF4" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                    <Separator Background="#222730" Margin="0,10,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="WIRE RATE" FontSize="10" Foreground="#8892B0"/>
                            <TextBlock x:Name="TxtRate" Text="0.0 Hz" FontSize="13" Foreground="#ECEFF4" Margin="0,1,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="SEQUENCE #" FontSize="10" Foreground="#8892B0"/>
                            <TextBlock x:Name="TxtSeq" Text="0" FontSize="13" Foreground="#ECEFF4" Margin="0,1,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="FIRMWARE" FontSize="10" Foreground="#8892B0"/>
                            <TextBlock x:Name="TxtFw" Text="v1.0.0" FontSize="13" Foreground="#ECEFF4" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Interactive Inputs (Cockpit Buttons & Pedals) -->
            <Border Grid.Row="2" Background="#16181D" BorderBrush="#222730" BorderThickness="1"
                    CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="INTERACTIVE SIMULATOR INPUTS (EV MESSAGES)" FontSize="11" FontWeight="Bold" Foreground="#65738E" Margin="0,0,0,8"/>
                    <WrapPanel Margin="0,0,0,0">
                        <Button x:Name="BtnParkBrake" Content="Set Park Brake" Click="BtnParkBrake_Click" Margin="0,0,8,6"/>
                        <Button Content="Pulse Left Pedal" Click="BtnLeftPedal_Click" Margin="0,0,8,6"/>
                        <Button Content="Pulse Right Pedal" Click="BtnRightPedal_Click" Margin="0,0,8,6"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- OTA Status Section -->
            <Border Grid.Row="3" Background="#16181D" BorderBrush="#222730" BorderThickness="1"
                    CornerRadius="6" Padding="14,8" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="OTA STATUS:" FontSize="10" FontWeight="Bold" Foreground="#65738E" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ProgressBar x:Name="OtaBar" Grid.Column="1" Height="6" Background="#222730" Foreground="#2ECC71" BorderThickness="0" Margin="0,0,10,0" Value="0" Maximum="100"/>
                    <TextBlock x:Name="TxtOtaStatus" Grid.Column="2" Text="Idle" FontSize="11" Foreground="#8892B0" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Bench Activity Log -->
            <Border Grid.Row="4" Background="#16181D" BorderBrush="#222730" BorderThickness="1"
                    CornerRadius="6" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="BENCH EVENT LOG" FontSize="11" FontWeight="Bold" Foreground="#65738E" Margin="4,0,0,6"/>
                    <ListBox x:Name="LogList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             Foreground="#B0B9CC" FontFamily="Consolas, monospace" FontSize="11"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
